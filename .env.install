######################################
#
#   安装参数
#   个性设置请写入 .env.install.local（不会提交到 Git），在本文件后加载。
#
######################################

# 安装路径
CLASHCTL_HOME=~/clashctl

# 安装内核：离线仓库提供 mihomo
CLASHCTL_KERNEL=mihomo

# 初始机场订阅
CLASHCTL_SUB_URL=

# 安装包固定随仓库提供于 vendor/linux-amd64-v1、v2 或 v3。
# 根据本机 CPU 选择兼容版本，并验证 PACKAGES.sha256；不会查询或下载更新。

# Web UI 压缩包路径（相对源码目录，必须列入 PACKAGES.sha256）
ZIP_UI=archives/dist.tar.gz
